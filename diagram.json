{
  "version": 1,
  "author": "Air Quality Monitor - IoT Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": -20,
      "left": 40,
      "attrs": {}
    },
    {
      "type": "wokwi-breadboard",
      "id": "bb1",
      "top": 160,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -240,
      "left": 35,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-gas-sensor",
      "id": "gas1",
      "top": -30,
      "left": -200,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -30,
      "left": 260,
      "attrs": { "temperature": "28", "humidity": "65" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_dht",
      "top": 10,
      "left": 330,
      "attrs": { "value": "10000" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 215,
      "left": 140,
      "attrs": {}
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:VIN", "bb1:tp.10", "red", [ "v30", "h-45", "v0" ] ],
    [ "esp:GND.1", "bb1:tn.10", "black", [ "v20", "h-35", "v0" ] ],

    [ "esp:3V3", "bb1:bp.25", "red", [ "v40", "h35", "v0" ] ],
    [ "esp:GND.2", "bb1:bn.25", "black", [ "v30", "h25", "v0" ] ],

    [ "bb1:tn.30", "bb1:bn.30", "black", [ "v0" ] ],

    [ "bb1:tp.23", "bb1:tp.28", "red", [ "h0" ] ],
    [ "bb1:tn.23", "bb1:tn.28", "black", [ "h0" ] ],
    [ "bb1:bp.23", "bb1:bp.28", "red", [ "h0" ] ],
    [ "bb1:bn.23", "bb1:bn.28", "black", [ "h0" ] ],

    [ "gas1:VCC", "bb1:tp.5", "red", [ "v100", "h-20" ] ],
    [ "gas1:GND", "bb1:tn.5", "black", [ "v110", "h-10" ] ],
    [ "gas1:AOUT", "esp:D34", "orange", [ "v30", "h120" ] ],

    [ "oled1:GND", "esp:GND.1", "black", [ "v-20", "h-70", "v120" ] ],
    [ "oled1:VCC", "esp:3V3", "red", [ "v-30", "h95", "v130" ] ],
    [ "oled1:SCL", "esp:D22", "cyan", [ "v-20", "h110", "v240" ] ],
    [ "oled1:SDA", "esp:D21", "blue", [ "v-10", "h125", "v215" ] ],

    [ "dht1:SDA", "esp:D15", "green", [ "h-60" ] ],
    [ "dht1:VCC", "bb1:bp.48", "red", [ "v120", "h20" ] ],
    [ "dht1:GND", "bb1:bn.48", "black", [ "v110", "h10" ] ],
    [ "r_dht:1", "dht1:VCC", "red", [ "h-20" ] ],
    [ "r_dht:2", "dht1:SDA", "green", [ "h-35" ] ],

    [ "esp:D23", "bb1:40.j", "purple", [ "v35", "h20" ] ],
    [ "bz1:1", "bb1:40.f", "purple", [ "v0" ] ],
    [ "bz1:2", "bb1:bn.40", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
